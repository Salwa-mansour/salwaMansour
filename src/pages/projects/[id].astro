---
import { getCollection, render } from 'astro:content';

// 1. Generate static paths for every project file
export async function getStaticPaths() {
    const projects = await getCollection('projects');
    return projects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

// 2. Grab the project passed from getStaticPaths
const { project } = Astro.props;
import { Image } from 'astro:assets';
// 3. Render the MDX content into HTML components
const { Content } = await render(project)
import Layout from '../../layouts/Layout.astro';
---
<Layout className={'project-page'} title={project.data.title}>
        <article>
           

          
              {project.data.image && (
                 <figure class="project-img">
                    <Image 
                        src={project.data.image} 
                        alt={project.data.title} 
                        width={400} 
                        height={225} 
                    /> 
                 </figure>
                )}
                <div class="project-header">
                    <h1 >{project.data.title}</h1>
                    <p class="date">{project.data.date}</p>
                    
                </div>
            
            <!-- Render the actual MDX body content here -->
             <div class="project-desc">
                 <Content />
             </div>
           
        </article>
</Layout>

<style>
    .project-img{
        position: relative;
        width: 80%;
        aspect-ratio: 3/2;
        margin: auto;
        border-radius: 5%;
        overflow: hidden;
        margin-bottom: 1rem;
    }
    .project-img img{
        position: absolute;
        inset: 0;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;

    }
    .project-header {
        text-align: center;
        margin-block: 2rem;
    }
    .project-desc{
        margin-block: 2rem;
    }
   /* Use :global() so the styles can pierce into the MDX content */
    :global(.project-desc img) {
        display: block;
        width: 80%;
        height: auto;
        margin-block: 1rem;
        margin-inline: auto;
    
    }
</style>