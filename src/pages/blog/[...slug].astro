---
import  Layout  from '../../layouts/Layout.astro';
import { sanityClient } from '../../lib/sanity';
import { urlFor } from '../../lib/imageBuilder';
import { PortableText } from '@portabletext/astro'; // 1. Import PortableText renderer

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post" && defined(slug.current)] {
    "slug": slug.current
  }`);

  return posts.map((post: any) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;

const post = await sanityClient.fetch(
  `*[_type == "post" && slug.current == $slug][0] {
    title,
    "slug": slug.current,
    publishedAt,
    excerpt,
    mainImage,
    body  // 2. Fetch the body field here
  }`,
  { slug }
);

if (!post) {
  return Astro.redirect('/404');
}
---

<Layout title={post.title} description={post.excerpt} image={post.mainImage} className="blog post">
   <article>
          <div class="post-header">
             <h1>{post.title}</h1>
             <small>Last Update : <time datetime={post.publishedAt} >
               {new Date(post.publishedAt).toLocaleDateString()}</time>
            </small> 
            <a href="/blog" class="back-link" title="Back to blog posts">
              <svg xmlns="http://w3.org" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
              <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
            </svg>
            </a>
             </div>
          {post.mainImage && (
            <figure>
                <img 
                  src={urlFor(post.mainImage).width(800).url()} 
                  alt={post.title} 
                  loading="lazy"
                />
            </figure>
          )}

          <p><em>{post.excerpt}</em></p>

          {/* 3. Render the Sanity Block Content */}
          <PortableText value={post.body} />
    </article>
</Layout>
<style>
  .post-header{
    position: relative;
    text-align: center;
  }
  .back-link{
    display:block;
    position: absolute;
    top: 0;
    left:20px;
    width:20px;
    height: 20px;
    font-size: 1.5rem;
    text-decoration: none;
    color: inherit;
  }
  /* .post article p{
    text-indent: 3rem;
  } */
</style>