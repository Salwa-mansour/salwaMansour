---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
// Fetch all project MDX files
const allProjects = await getCollection('projects');
import   InteractiveCard  from '../components/InteractiveCard.astro';
---

  <section id="works" class="projcets">
    <section class="section-header">
      <h1>My Projects</h1>
        
    </section>

       
        <div class="projects-grid">
            {allProjects.map((project) => (
              
                <InteractiveCard id={project.id} title={project.data.title} summary={project.data.summary} url={project.data.url}  />
            ))}
        </div>
</section>

<style>
    .projects-grid{
        display: flex;
        flex-wrap: wrap;
        gap: 3rem;
     
        align-items: center;
        justify-content: center;
       
    }
  
      
   
</style>