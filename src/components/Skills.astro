<section class="skills">


<div class="skills-box">
    <svg class="box" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 350" width="100%" height="100%">
  <!-- Box Base Group -->
  <g id="box-base">
    <!-- Main Box Body -->
    <rect x="75" y="105" width="350" height="195" fill="#C29468" />
    
    <!-- Shadow under the lid -->
    <rect x="75" y="105" width="350" height="12" fill="#AD7E53" />
    
    <!-- Handle Cutout -->
    <rect x="220" y="126" width="60" height="16" fill="#FFFFFF" rx="2" ry="2" />
  </g>

  <!-- Cover / Lid Group -->
  <g id="box-cover">
    <!-- Lid Rim / Lip Shadow (optional detail) -->
    <!-- Cover Main Body -->
    <rect x="45" y="65" width="410" height="40" fill="#D29F6C" />
  </g>
    </svg>

</div>  
</section>

<style>
    .skills-box{
        width: 10vw;
       height: auto; 
    }
    .skills-box .box{
        width: 100%;
        object-fit: cover;
    }
</style>