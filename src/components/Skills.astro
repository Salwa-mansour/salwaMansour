</div>
</div>  

<ul class="toolkit-list" >
    <li>html</li>
    <li>css</li>
    <li>javascrt</li>
    <li>git</li>
    <li>responsiv design</li>
    <li>node.js</li>
    <li>express</li>
    <li>react</li>
    <li>gsap</li>
    <li>astro</li>
    <li>sanity</li>
</ul>
</section>

<script>
import { gsap } from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

gsap.registerPlugin(ScrollTrigger);

document.addEventListener("DOMContentLoaded", () => {
    const icons = gsap.utils.toArray('.item-icon');
    const boxContainer = document.querySelector('.box-container');
    const toolkitList = document.querySelector('.toolkit-list');

    let mm = gsap.matchMedia();

    // 1. Desktop Animation Function
    const runDesktopAnimations = () => {
        gsap.set('.box-cover', { transformOrigin: "25% 20%" });
        gsap.set(icons, { opacity: 0, scale: 0, x: 0, y: 0 });
        if (toolkitList) gsap.set(toolkitList, { opacity: 0 });

        const desktopTl = gsap.timeline({ paused: true });

        desktopTl.to('.box-container', { rotate: -90, duration: 0.5, ease: "power2.inOut" }, 0)
                 .to('.box-cover', { rotate: -90, duration: 0.5, ease: "back.out(2)" }, 0)
                 .to(icons, {
                     x: () => gsap.utils.random(-800, -300),
                     y: () => gsap.utils.random(-250, 0),
                     scale: () => gsap.utils.random(0.75, 1.2),
                     opacity: 1,
                     duration: 1,
                     stagger: 0.05,
                     ease: "power2.out"
                 }, "-=0.3")
                 .to(icons, {
                     x: "+=random(-50, 50)",
                     y: "+=random(-30, 30)",
                     rotation: "random(-15, 15)",
                     duration: 1.5,
                     yoyo: true,
                     repeat: 1.5, 
                     ease: "sine.inOut",
                     stagger: 0.05
                 })
                 .to(icons, {
                     x: 0,
                     y: 0,
                     scale: 0,
                     opacity: 0,
                     duration: 0.8,
                     stagger: 0.03,
                     ease: "power2.in"
                 })
                 .to('.box-container', { rotate: 0, duration: 0.5, ease: "power2.inOut" }, "-=0.5")
                 .to('.box-cover', { rotate: 0, duration: 0.5, ease: "power2.inOut" }, "-=0.5")
                 .to(toolkitList, {
                     opacity: 1,
                     duration: 1,
                     ease: "power2.out"
                 }, '<-=1');

        const clickHandler = () => {
            if (desktopTl.isActive()) return;
            desktopTl.restart();
        };
        boxContainer?.addEventListener('click', clickHandler);

        const st = ScrollTrigger.create({
            trigger: ".skills",
            start: "top 75%",
            onEnter: () => {
                if (desktopTl.isActive()) return;
                desktopTl.restart();
            },
            onEnterBack: () => {
                if (desktopTl.isActive()) return;
                desktopTl.restart();
            },
        });
    // Optional manual click trigger
    boxContainer?.addEventListener('click', () => {
        if (desktopTl.isActive()) return;
        desktopTl.restart();
    });
        return () => {
            st.kill();
            desktopTl.kill();
            boxContainer?.removeEventListener('click', clickHandler);
        };
    };

    // 2. Mobile Animation Function
    const runMobileAnimations = () => {
        gsap.set(icons, { opacity: 0, scale: 0, x: 0, y: 0 });
        if (toolkitList) gsap.set(toolkitList, { opacity: 0, y: 30 });
        
        const mobileTl = gsap.timeline({ paused: true });
        mobileTl.to('.box-container', { rotate: -180, duration: 0.5, ease: "power2.inOut" }, 0)
                .to('.box-cover', { rotate: -5, yPercent: -500, duration: 0.5, ease: "power2.inOut" })
                .to('.box-cover', { rotate: 0, duration: 0.25, ease: "power2.inOut" },'>-=0.1')
                 .to(icons, {
                     x: () => gsap.utils.random(300, 0),
                     y: () => gsap.utils.random(400, 50),
                     scale: () => gsap.utils.random(0.75, 1.2),
                     opacity: 1,
                     duration: 1,
                     stagger: 0.05,
                     ease: "power2.out"
                 }, "-=0.3")
                 .to(icons, {
                     x: "+=random(-80, 80)",
                     y: "+=random(-30, 30)",
                     rotation: "random(-15, 15)",
                     duration: 1.5,
                     yoyo: true,
                     repeat: 1.5, 
                     ease: "sine.inOut",
                     stagger: 0.05
                 })
                 .to(icons, {
                     x: 0,
                     y: 0,
                     scale: 0,
                     opacity: 0,
                     duration: 0.8,
                     stagger: 0.03,
                     ease: "power2.in"
                 })
                 .to('.box-cover', {  yPercent: 0, duration: 0.5, ease: "power2.inOut" })
                 .to('.box-container', { rotate: 0, duration: 0.5, ease: "power2.inOut" })
                  .to(toolkitList, {
                     opacity: 1,
                     duration: 1,
                     ease: "power2.out"
                 }, '<-=1');

        const st = ScrollTrigger.create({
            trigger: ".skills",
            start: "top 85%",
             onEnter: () => {
                if (mobileTl.isActive()) return;
                mobileTl.restart();
            },
            onEnterBack: () => {
                if (mobileTl.isActive()) return;
                mobileTl.restart();
            },
        });
    // Optional manual click trigger
    boxContainer?.addEventListener('click', () => {
        if (mobileTl.isActive()) return;
        mobileTl.restart();
    });
        return () => {
            st.kill();
            mobileTl.kill();
        };
    };

    mm.add("(min-width: 771px)", () => {
        return runDesktopAnimations();
    });

    mm.add("(max-width: 770px)", () => {
        return runMobileAnimations();
    });
});
</script>
<style>
    .skills-container{
       position: relative;
    }
    .box-container{
         width: 30vw;
        position: relative;
       aspect-ratio: 2/1; 
    }
    .box-container .box{
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .skills{
     
        display: grid;
        align-items: center;
        justify-items: center;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        grid-template-areas: 
        "header header"
        "list icons"
        "list icons";
    }
    .section-header{
        grid-area: header;
    }
    .skills-container{
        grid-area: icons;
    }
    .toolkit-list{
        grid-area: list;
      justify-self: end;
    } 
    .icons{
        display: contents;
    }
    .item-icon{
      position: absolute;
      bottom: 0;
      right: 50%;
      width: 40px;
      height: 40px;
      opacity: 0;
    }
    .item-icon svg{
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
    .toolkit-list {
        list-style: initial;
        display: grid;
        grid-template-columns: repeat(2, 1fr); /* Creates two equal columns */
        gap: 1rem; /* Adds nice spacing between the items */
        list-style: none; /* Removes default bullet points if you want a cleaner look */
        padding: 0;
    }

    .toolkit-list li {
   
        padding: 0.75rem 1rem;
      
      text-transform: capitalize;
        font-weight: 500;
    }
     @media (max-width:770px) {
       
        .skills{
            overflow: hidden;
            over
            gap:0;
             grid-template-columns: 1fr 1fr auto auto;
            grid-template-areas: 
            "icons header header . "
            "list list list list "
            "list list list list";
        }
        .item-icon{
        bottom: 50%;
        /* right: 0; */
        width: 30px;
        height: 30px;
        }
        .toolkit-list{
    
      justify-self: unset;
         } 
         .section-header{
            justify-self: start;
         }
         .section-header h1{
            padding: 0;
         }
         .skills-container{
            justify-self: end;
         }
    }
</style>