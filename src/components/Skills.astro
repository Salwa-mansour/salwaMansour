</section>

<script>
import { gsap } from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

gsap.registerPlugin(ScrollTrigger);

document.addEventListener("DOMContentLoaded", () => {
    const icons = gsap.utils.toArray('.item-icon');
    const boxContainer = document.querySelector('.box-container');
    const toolkitList = document.querySelector('.toolkit-list');
    
    // Set initial transform origins and starting states
    gsap.set('.box-cover', { transformOrigin: "25% 20%" });
    gsap.set(icons, { opacity: 0, scale: 0, x: 0, y: 0 });
    gsap.set(toolkitList, { opacity: 0 });

    const toolkitTl = gsap.timeline({
        paused: true
    });

    // 1. Rotate container & box cover simultaneously (Open)
    toolkitTl.to('.box-container', { rotate: -90, duration: 0.5, ease: "power2.inOut" }, 0)
              .to('.box-cover', { rotate: -90, duration: 0.5, ease: "back.out(2)" }, 0);

    // 2. Scatter icons out from the box
    toolkitTl.to(icons, {
        x: () => gsap.utils.random(-800, -300),
        y: () => gsap.utils.random(-250, 0),
        scale: () => gsap.utils.random(0.75, 1.2),
        opacity: 1,
        duration: 1,
        stagger: 0.05,
        ease: "power2.out"
    }, "-=0.3");

    // 3. Icons yoyo/floating animation
    toolkitTl.to(icons, {
        x: "+=random(-50, 50)",
        y: "+=random(-30, 30)",
        rotation: "random(-15, 15)",
        duration: 1.5,
         yoyo: true,
         repeat:1.5, 
        ease: "sine.inOut",
        stagger: 0.05
    });

    // 4. Reset icons back to initial state (shrinking and returning to 0,0)
    toolkitTl.to(icons, {
        x: 0,
        y: 0,
        scale: 0,
        opacity: 0,
        duration: 0.8,
        stagger: 0.03,
        ease: "power2.in"
    });

    // 5. Rotate box and cover back to 0 (Close the box)
    toolkitTl.to('.box-container', { rotate: 0, duration: 0.5, ease: "power2.inOut" }, "-=0.5")
              .to('.box-cover', { rotate: 0, duration: 0.5, ease: "power2.inOut" }, "-=0.5");

    // 6. Trigger the toolkit list opacity fade-in last
    toolkitTl.to(toolkitList, {
        opacity: 1,
        duration: 1,
        ease: "power2.out"
    },'<-=1');

    // ScrollTrigger to play/restart the animation cleanly on scroll
    ScrollTrigger.create({
        trigger: ".skills",
        start: "top 75%",
        // markers: true,
        onEnter: () =>{
            if(toolkitTl.isActive()) return;
            toolkitTl.restart();
        },
        onEnterBack: () => {
            if(toolkitTl.isActive()) return;
            toolkitTl.restart();},
    });

    // Optional manual click trigger
    boxContainer?.addEventListener('click', () => {
        if (toolkitTl.isActive()) return;
        toolkitTl.restart();
    });
});
</script>
<style>
    .skills-container{
       position: relative;
    }
    .box-container{
         width: 30vw;
        position: relative;
       aspect-ratio: 2/1; 
    }
    .box-container .box{
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .skills{
        padding: 1rem;
        display: grid;
        align-items: center;
        justify-items: center;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        grid-template-areas: 
        "header header"
        "list icons"
        "list icons";
    }
    .section-header{
        grid-area: header;
    }
    .skills-container{
        grid-area: icons;
    }
    .toolkit-list{
        grid-area: list;
      
    } 
    .icons{
        display: contents;
    }
    .item-icon{
      position: absolute;
      bottom: 0;
      right: 50%;
      width: 40px;
      height: 40px;
    }
    .item-icon svg{
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
    .toolkit-list {
        list-style: initial;
        display: grid;
        grid-template-columns: repeat(2, 1fr); /* Creates two equal columns */
        gap: 1rem; /* Adds nice spacing between the items */
        list-style: none; /* Removes default bullet points if you want a cleaner look */
        padding: 0;
    }

    .toolkit-list li {
   
        padding: 0.75rem 1rem;
      
      text-transform: capitalize;
        font-weight: 500;
    }
     @media (max-width:770px) {
       
        .skills{
      
        grid-template-areas: 
        "header icons"
        "list list"
        "list list";
        }
    }
</style>