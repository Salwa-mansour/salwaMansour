<script>
import { gsap } from "gsap";



document.addEventListener("DOMContentLoaded", () => {
    const icons = gsap.utils.toArray('.item-icon');
    const boxContainer = document.querySelector('.box-container');
    
    // Set initial transform origins and starting states
  
    gsap.set('.box-cover', { transformOrigin: "25% 20%" });
    gsap.set(icons, { opacity: 0, scale: 0, x: 0, y: 0 });

    const toolkitTl = gsap.timeline({
        paused: true,
        onComplete: () => {
            // Once the open animation finishes, start the finite floating effect
            icons.forEach(icon => {
                gsap.to(icon, {
                    x: "+=random(-50, 50)",
                    y: "+=random(-50, 50)",
                    rotation: "random(-12, 12)",
                    duration: "random(2, 4)",
                    ease: "sine.inOut",
                    yoyo: true,
                    repeat: 3 // Repeats back-and-forth 10 times then stops
                });
            });
        }
    });

    // 1. Rotate container
    toolkitTl.to('.box-container', { rotate: -90, duration: 0.5, ease: "power2.inOut" }, 0);

    // 2. Rotate box cover simultaneously
    toolkitTl.to('.box-cover', { rotate: -90, duration: 0.5, ease: "back.out(2)" }, 0);

    // 3. Scatter icons
    toolkitTl.to(icons, {
        x: () => gsap.utils.random(-100, 100),
        y: () => gsap.utils.random(-100, 100),
        scale: () => gsap.utils.random(0.8, 1.3),
        opacity: 1,
        duration: 1,
        stagger: 0.05,
        ease: "power2.out"
    }, "-=0.3");

    // Toggle play/reverse on click
    boxContainer?.addEventListener('click', () => {
        if (toolkitTl.progress() === 0) {
            toolkitTl.play();
        } else {
            // Kill any active floating tweens before reversing so they slide back smoothly
            icons.forEach(icon => gsap.killTweensOf(icon));
            toolkitTl.reverse();
        }
    });
});
</script>

<style>
    .skills-container{
       position: relative;
    }
    .box-container{
         width: 30vw;
        position: relative;
       aspect-ratio: 2/1; 
    }
    .box-container .box{
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .section-header h1{
        text-align: center;
        text-transform: capitalize;
    }
   
    .skills{
        padding: 1rem;
        display: grid;
        align-items: center;
        justify-items: center;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        grid-template-areas: 
        "header header"
        "list icons"
        "list icons";
    }
    .section-header{
        grid-area: header;
    }
    .skills-container{
        grid-area: icons;
    }
    .toolkit-list{
        grid-area: list;
      
    } 
    .icons{
        display: contents;
    }
    .item-icon{
      position: absolute;
      top: 0;
      left: 0;
      width: 30px;
      height: 30px;
    }
    .item-icon svg{
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
</style>