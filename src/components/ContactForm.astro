---
---
<section class="contact-section">
   
  <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="contact-form">
         <!-- Required hidden input for Netlify forms -->
       <input type="hidden" name="form-name" value="contact" />
       <!-- Honeypot spam protection field (hidden from real users via CSS if desired) -->
    <p style="display: none;">
        <label>Don’t fill this out if you're human: <input name="bot-field" /></label>
    </p>

        <input type="email" name="email" id="" placeholder="your email">
        <textarea name="message" cols="30" rows="10" id="" placeholder="your message"></textarea>
        <button type="submit">send</button>
    </form>
</section>
<script>
    const form = document.querySelector('.contact-form') as HTMLFormElement;

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(form);

        try {
            await fetch('/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams(formData as any).toString()
            });

            alert('Message sent successfully!');
            form.reset();
        } catch (error) {
            alert('Form submission failed. Please try again.');
        }
    });
</script>
<style>
    .contact-form{
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        width: 80%;
    }
    .contact-section{
        padding: 1rem 2rem;
        flex: 0 0 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .contact-form input,
    .contact-form textarea{
        width: 100%;
    background: #0000008f;
    outline: none;
    border: 2px solid #ffffffa6;
    border-radius: 24px;
    padding: 1rem;
    color: white;
    
    }
    .contact-form button{
      
    height: 3.5em;
    width: 7em;
  
    border: none;
    border-top: 3px solid #FF8C28;
    border-radius: 0 0 0.2em 0.2em;
    border-radius: 24px;
    /* -webkit-transform-origin: 50% 5em;
    -ms-transform-origin: 50% 5em;
    transform-origin: 50% 5em; */
  background: rgba(0, 0, 0, 0.8);
    color: #d1deea;
    line-height: 1;
    }
     @media (max-width:770px) {
       
        .contact-section{
        flex: 0 0 100%;
    }
       
    }
</style>