---
import  ContactForm  from "./ContactForm.astro";
---
<footer class="footer">

    
   <section class="contact-info">
      <div class="section-header">
         <h1>contact me now</h1>
     </div>
         <ul class="contact-list">
            <li><a href="">
                <object type="image/svg+xml" data="./images/GitHub.svg" >
                <!-- Fallback content if the browser doesn't support SVG/object -->
                    GitHub
                </object>
            </a></li>
            <li><a href="">
                <object type="image/svg+xml" data="./images/GitHub.svg" >
                <!-- Fallback content if the browser doesn't support SVG/object -->
                    GitHub
                </object>
            </a></li>
            <li><a href="">
                <object type="image/svg+xml" data="./images/GitHub.svg" >
                <!-- Fallback content if the browser doesn't support SVG/object -->
                    Git
                </object>
            </a></li>
         </ul>
   </section>
   <ContactForm/>
   <div class="copy-rights">copy write resceved {Date.now()}</div>
</footer>

<style>
    .footer{
        display: flex;
        flex-wrap: wrap;
         background: rgba(0, 0, 0, 0.3);
    }
    .footer section{
         padding: 1rem 2rem;
        flex: 0 0 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    .copy-rights{
        padding: 1rem;
        background-color: rgba(0, 0, 0, 0.321);
       width: 100%;
       text-align: center;
    }
    .contact-list{
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;

    }
    .contact-list li{
        width: 50px;
        height: 50px;
    }
    .contact-list li a{
        display: block;
        width: 100%;
        height: 100%;
       
    }
    .contact-list object{
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
      @media (max-width:770px) {
         .footer section{
        flex: 0 0 100%;
        }
    }
</style>