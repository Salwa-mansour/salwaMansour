---
interface Props {
  techIcon: string;
}

const { techIcon } = Astro.props;
---

<figure class="tech-icon">
  <!-- <object type="image/svg+xml" data={`./images/${techIcon}.svg`}>
   {techIcon}
  </object> -->
  <img src={`./images/${techIcon}.svg`} alt={techIcon} title={techIcon}>
</figure>

<style>
    .tech-icon{
        width: 20px;
        height: 20px;
       display: block;
    }
    .tech-icon img{
      display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
</style>