---
import Icon from '../components/Icon.astro';

interface Props {
  id: string; 
  title?: string;
  summary?: string;
  teckStack: string[]; // 👈 Fixed array syntax
  url?: string;
  gitHubUrl?: string;
}

const {
  id,         
  title = "lorem title",
  summary = "lorem disc lorem desc",
  teckStack, // 👈 Added missing comma here
  url = '#',
  gitHubUrl = '#'
} = Astro.props;
---

<article class="interactive-card">
  <!-- Live Preview Underlay Card -->
  <a href={url} class="preview-link" target="_blank" rel="noopener noreferrer">
    <span class="preview-text">
      Live Preview 
      <svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17L17 7"></path>
        <path d="M7 7h10v10"></path>
      </svg>
    </span>
  </a>

  <!-- Top Front Card -->
  <div class="card-content" aria-label={title}>
    <!-- High-Performance Static Shadow Layer (Faded via GSAP Opacity) -->
    <div class="card-shadow-layer"></div>
      <ul class="tech-stack-list" aria-label="tech stack list">
          {
            teckStack.map((tech) => (
              <Icon techIcon={tech} />
            ))
          }
        </ul>
    <h3 class="card-title">{title}</h3>
    
   

    {summary && <p class="card-desc">{summary}</p>}
    <a href={gitHubUrl} class="github-link">
        <Icon techIcon="GitHub"/>
        <span>view in github</span>
    </a>
    <div class="card-glow"></div>
    <!-- <a href={`/projects/${id}`} class="title-link"></a> -->
  </div>
</article>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const cards = document.querySelectorAll<HTMLElement>('.interactive-card');

  cards.forEach((card) => {
    const cardContent = card.querySelector<HTMLElement>('.card-content');
    const previewText = card.querySelector<HTMLElement>('.preview-text');
    const arrowIcon = card.querySelector<HTMLElement>('.arrow-icon');
    const cardShadow = card.querySelector<HTMLElement>('.card-shadow-layer');

    let mm = gsap.matchMedia();

    // 1. DESKTOP: Mouse hover & movement animations
    mm.add("(hover: hover)", () => {
      const hoverTl = gsap.timeline({
        paused: true,
        defaults: { ease: 'power3.out', duration: 0.4 }
      });

      hoverTl
        .to(cardContent, { transform: 'translate(-12px, -8px) rotate(-10deg)', transformOrigin: 'bottom left' }, 0)
        .to(cardShadow, { opacity: 1 }, 0)
        .to(previewText, { x: 4, y: 4 }, 0)
     
      const mouseMoveHandler = (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        // 👈 Fixed template literals for dynamic mouse position
        card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
      };

      card.addEventListener('mouseenter', () => hoverTl.play());
      card.addEventListener('mouseleave', () => hoverTl.reverse());
      card.addEventListener('mousemove', mouseMoveHandler);

      return () => {
        card.removeEventListener('mouseenter', () => hoverTl.play());
        card.removeEventListener('mouseleave', () => hoverTl.reverse());
        card.removeEventListener('mousemove', mouseMoveHandler);
      };
    });

    // 2. MOBILE / TOUCH: Scroll-driven card-peel effect that reverts past the end point
    mm.add("(hover: none), (pointer: coarse)", () => {
      const scrollTl = gsap.timeline({
        defaults: { ease: 'power2.out', duration: 0.5 },
        scrollTrigger: {
          trigger: card,
          start: 'top 70%',
          end: 'bottom center', 
          toggleActions: 'play reverse play reverse'
        }
      });

      scrollTl
        .to(cardContent, { 
          transform: 'translate(-8px, -10px) rotate(-10deg)', 
          transformOrigin: 'bottom left' 
        }, 0)
        .to(cardShadow, { opacity: 1 }, 0);
    });
  });
</script>

<style>
  .interactive-card {
    position: relative;
    border-radius: 1.25rem;
    min-height: 250px;
    width: 100%;
    max-width: 380px;
    margin: 1.5rem;
    perspective: 1000px;
  }

  /* --- LIVE PREVIEW UNDERLAY CARD --- */
  .preview-link {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #ffa048 0%, #f97316 55%, #ea580c 100%);
    border-radius: 1.25rem;
    padding: .75rem 1rem;
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    text-decoration: none;
    box-shadow: 0 10px 25px -5px rgba(249, 115, 22, 0.3);
  }

  .preview-text {
    font-weight: 700;
    font-size: 1.05rem;
    text-transform: capitalize;
    color: #0f1724;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    letter-spacing: -0.01em;
  }

  /* --- FRONT TOP CARD CONTENT --- */
  .card-content {
    position: relative;
    z-index: 2;
    background: linear-gradient(135deg, #2e3e55 0%, #0f1724 100%);
    border-radius: 1.25rem;
    padding: 2rem;
    color: #f8fafc;
    text-decoration: none;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    text-align: center;
    align-items: center;
    justify-content: space-evenly;
    height: 260px;
    will-change: transform;
  }

  /* --- PERFORMANCE OPTIMIZED SHADOW LAYER --- */
  .card-shadow-layer {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: -15px 25px 35px -10px rgba(0, 0, 0, 0.7), 
                0 0 25px rgba(249, 115, 22, 0.25);
    opacity: 0;
    pointer-events: none;
    z-index: 0;
    will-change: opacity;
  }

  /* .title-link {
    position: absolute;
    inset: 0;
    border-radius: inherit;  
    z-index: 3;
  } */

  /* --- TYPOGRAPHY & LINKS --- */
  .card-title {
    
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
    /* line-height: 1.3; */
    margin: 0;
    position: relative;
    z-index: 2;
    text-transform: capitalize;
  }

.github-link{
      display: flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    color: white;
    text-transform: capitalize;
}

  .card-desc {
    font-size: 0.95rem;
    color: #cbd5e1;
   
    line-height: 1.5;
    position: relative;
    z-index: 2;
  }

  .tech-stack-list {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-bottom: 0.75rem;
    position: relative;
    z-index: 2;
  }

  /* --- DYNAMIC SPOTLIGHT GLOW EFFECT --- */
  .card-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      500px circle at var(--mouse-x, 0) var(--mouse-y, 0),
      rgba(253, 232, 218, 0.12),
      transparent 45%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 1;
  }

  .interactive-card:hover .card-glow {
    opacity: 1;
  }
     @media (max-width:770px) {
      .card-content{
        padding: 1rem;
      }
     }
</style>