<section class="bio">


   <div  class="site-branding">
    <div id="name-conainer">
        <h1 class="dev-name">
    
            <span class="rotate-letter">W</span>
            <span class="rotate-letter">e</span>
            <span class="rotate-letter">l</span>
            <span class="rotate-letter">l</span>
            <span class="rotate-letter">c</span>
            <span class="rotate-letter">o</span>
            <span class="rotate-letter">m</span>,
            <span class="rotate-letter">I&#039;</span>
            <span class="rotate-letter">m</span>
            <span class="rotate-letter">S</span>
            <span class="rotate-letter">a</span>
            <span class="rotate-letter">l</span>
            <span class="rotate-letter">w</span>
            <span class="rotate-letter">a</span>
            <span>(＾▽＾);</span>
        </h1>

    </div>


    <p class="site-description">
        A front end  developer based in Yemen. As a creative problem solver,
            I will help you convert your idea into a live website representing your brand in 
            the internet world.
        I love working with animation and creative ideas and my workflow is focused on 
        performance acessiablity and responsive design.</p>
    </div><!-- .site-branding -->

<div class="wellcom">
    <figure class="hand-box my-hand">
         <img src="./images/myhand.png" alt="my hand" >
    </figure>
   <figure class="hand-box your-hand">
      <figcaption class="start-shaking">click the hand</figcaption>
       <span class="puppy-arrow">&#8595;</span>
      <img src="./images/yourhand.png" alt="your hand" >
   </figure>
   
   <figure class="hand-box shake-hands">
    <img class="hand-img" src="./images/shakehand1.png" alt="shake hand" >
    <figcaption class="meet-txt">nice to meet you(✯◡✯)</figcaption>

   </figure>
    

</div><!--wellcom-->
 </section><!--class-bio -->

 <script>
    import { gsap } from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
        const letters = gsap.utils.toArray('.rotate-letter');
        const arrow = document.querySelector('.puppy-arrow');
        const yourHand =document.querySelector('.your-hand');
        const myHand = document.querySelector('.my-hand');
        const shakeHands = document.querySelector('.hand-img');
        const meetText = document.querySelector('.meet-txt');
        let clickCount = 0;

        gsap.set(arrow, { display: "inline-block", transformOrigin: "top center" });
        gsap.set([shakeHands,meetText],{opacity:0});
        // GSAP animates from these starting values TO their natural CSS state
        gsap.from(letters, {
            rotation: -25,
            duration: 0.5,
            ease: "back.out(1.7)",
            stagger: 0.02
        });
        // Create the infinite bounce loop
        // gsap.to(arrow, {
        //     scale: 1.05,            // Grow to 1.4 times its size
           
        //     duration: 0.5,         // How long one loop takes
        //     ease: "eas.inOut",  // Smooth acceleration/deceleration
        //     yoyo: true,            // Goes forward, then reverses back to start
        //     repeat: -1             // Repeats infinitely
        // });

        const handShakeTl =gsap.timeline({paused:true,
            onComplete: () => {
        // Automatically reverse the timeline back to the start when it finishes
        handShakeTl.reverse();
    }
        });
        handShakeTl.to(['.start-shaking',arrow],{opacity:0,duration:0.05},0);
        handShakeTl.to(yourHand,{
            xPercent: -220, // Handles percentage-based translateX
            yPercent: 120,  // Handles percentage-based translateY
            rotation:-15,  // Handles rotation in degrees
            scale: 0.5,    // Handles scaling
            duration:0.7,
            ease:"power1.in"
        },0);
        handShakeTl.to(myHand,{
            xPercent: 220, // Handles percentage-based translateX
            yPercent: 120,  // Handles percentage-based translateY
            rotation: -15,  // Handles rotation in degrees
            scale: 0.5 ,    // Handles scaling
            duration:0.7,
            ease:"power1.in"
        },0)
       
        handShakeTl.to([myHand,yourHand],{opacity:0,duration:0.3})
        handShakeTl.to([shakeHands,meetText],{opacity:1,duration:0.75},'<');
        handShakeTl.to(shakeHands,{
            y:-20,
            // yoyo:true,
            // repeat:1.5,
            duration:.3,
            ease:"power1.in"
        },'<')
     // Click handler that triggers the animation if it's currently at the start
       const triggerHandShake = () => {
            if (handShakeTl.progress() === 0) {
                handShakeTl.play();

                // Increment click count and update text based on state
                clickCount++;

                if (meetText) {
                    if (clickCount === 1) {
                        meetText.textContent = "nice to meet you";
                    } else if (clickCount === 2) {
                        meetText.textContent = "what's up friend (o^▽^o)";
                    } else if (clickCount === 3) {
                        // Use innerHTML here so the <a> tag renders correctly as a link
                        meetText.innerHTML = "wanna talk more <a href='#'>click here</a>";
                        
                        // Reset count back to 0 so the next click loops back to the start
                        clickCount = 0;
                    }
                }
            }
        };

    yourHand?.addEventListener('click', triggerHandShake);
    myHand?.addEventListener('click', triggerHandShake);
    });
</script>

<style>
    .bio{
        display: flex;
        justify-content: space-around;
        
        align-items: center;
        max-width: 900px;
        min-height: 500px;
        padding-inline: 1rem;
        gap: 2rem;
        margin: auto;
    }
    .rotate-letter {
    display: inline-block;
    margin-right: 2px;
    color: #FF8C28;}
    .wellcom{
        position: relative;
        height: 300px;
        flex: 0 0 50%;
    }
    .site-branding,
    .wellcom{
        flex: 0 0 50%;
    }
    .wellcom .hand-box{
        position: absolute;
     
        width:70px ;
        height: 50px;
    }
    .hand-box figcaption{
        white-space: nowrap;
    }
     .hand-box img{
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
    .my-hand{
     
        left: .75rem;
        top: 50%;
        transform:rotate(-10deg) translateY(-50%);
    }
    .your-hand{
        right: .75rem;
        top: 50%;
        transform:rotate(10deg) translateY(-50%);
    }
    .start-shaking{
        position: absolute;
        top: -50%;
        left: -50%;
    }
    .puppy-arrow{
        position: absolute;
        display: inline-block;
        padding: .2rem;
        right: -10%;
        top: -80%;
        font-size: 2rem;
        color: orange;
        transform: rotate(22deg);
    }
    .shake-hands{
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
    }
    @media (max-width:770px) {
      
        .bio{
            flex-wrap: wrap;
        }
    .site-branding,
    .wellcom{

        flex: 0 0 100%;
    }
    }
</style>
