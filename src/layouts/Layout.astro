---
import "../styles/index.css"
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// Define the interface for props coming from pages
interface Props {
    title?: string;
    className?: string; 
    description?: string; 
    image?: string; 
}

// Extract props with default fallback values
// const { title = "Salwa Mansour | Portfolio", className = "" } = Astro.props;
const { 
  title = "Salwa Mansour | Portfolio",
  className = "",
  description = "Hi ,I'm Salwa. a creative problem solver, I will help you convert your idea into a live website",
  image = "/og-image.png" // Default fallback image in your public folder
} = Astro.props;

// Construct the full URL for social media crawlers
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.url);
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
       <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />

        <meta name="description" content={description} />

        <!-- Open Graph / Facebook / LinkedIn / Discord -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageURL} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageURL} />

        <meta name="generator" content={Astro.generator} />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
        
        <!-- Dynamic Page Title -->
        <title>{title}</title>
    </head>
    <body >
        <Header/>
        <main class={className} >
            <slot />
        </main>
        <Footer/>
    </body>
</html>