---
import "../styles/index.css"
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// Define the interface for props coming from pages
interface Props {
    title?: string;
    className?: string; // Optional custom class for the body or wrapper
}

// Extract props with default fallback values
const { title = "Salwa Mansour | Portfolio", className = "" } = Astro.props;
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
        
        <!-- Dynamic Page Title -->
        <title>{title}</title>
    </head>
    <body >
        <Header/>
        <main class={className} >
            <slot />
        </main>
        <Footer/>
    </body>
</html>